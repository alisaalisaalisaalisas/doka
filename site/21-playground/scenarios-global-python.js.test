/* Test */
S("Python","gc-py-1","argparse: required arg missing","Junior",`<h3>Контекст</h3><p>Python: <b>argparse: required arg missing</b>. Файл <code>app.py</code> сломан.</p><h3>Что происходит</h3><p>Симптом: argparse: required arg missing. Проверка падает.</p><h3>Что нужно сделать</h3><ul><li>[ ] диагностика</li><li>[ ] исправить</li></ul><h3>Ограничения</h3><p>Меняйте только <code>app.py</code>.</p><h3>Стартовое состояние</h3><p>Файлы: <code>app.py</code>. Активный: <code>app.py</code>.</p><h3>Ожидаемый результат</h3><p>Чек-лист зелёный.</p><h3>Проверка</h3><pre>cat app.py</pre>`,"dev@py:~$",[["^python3 app.py --help | head -20",`error or missing output`,"err"],["^python3 app.py 2>&1 | grep -i error | head -5",`check output`,"warn"],["^sed -i s/required=False/required=True/ app.py",`fixed`,"ok"],["^python3 app.py --arg val | head -5",`ok verified`,"ok"]],[{re:"^python3 app.py --help | head -20",l:"диагностика"},{re:"^sed -i s/required=False/required=True/ app.py",l:"исправить"}],{file:"app.py",files:{"app.py":`import argparse\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--input\", required=False)  # BUG\nargs = parser.parse_args()\n`},checks:[{re:/required\\s*=\\s*True/,l:"required=True"}],solutionFiles:{"app.py":`import argparse\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--input\", required=True)\nargs = parser.parse_args()\n`}},{hints:["Hint1 for argparse: required arg missing","Hint2 for argparse: required arg missing","Hint3 for argparse: required arg missing"]});